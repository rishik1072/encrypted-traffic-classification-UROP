# ==============================================================================
# Git Ignore Configuration: Real-Time Encrypted Traffic Classification
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & dynamic libraries
*.dll
*.dylib

# PyInstaller / Build / Distribution Artifacts
build/
dist/
dist_build/
*.spec.bak
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Archives & recursive bundles
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Runtime Logs
*.log
packaged_runtime.log
results/realtime/*.log

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Large Raw PCAP Captures (Keep manifests & metadata, exclude heavy binary captures)
*.pcap
*.pcapng
*.cap
!data/raw/pcap/*.pcap

# Temporary scratch & cache directories
scratch/
tmp/
temp/

